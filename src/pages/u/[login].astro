---
import ProfileApp from '../../app/ProfileApp';
import Base from '../../layouts/Base.astro';
import { featuredLogins } from '../../lib/featured';

// Featured logins get a real page, so their links answer 200 and unfurl with a preview. Any other login is
// served by 404.html, which renders the same profile.
export function getStaticPaths() {
  return featuredLogins().map((login) => ({ params: { login } }));
}

const { login } = Astro.params;
---

<Base
  title={`@${login} · git-card`}
  description={`@${login} on GitHub, as a city: 3D contribution skyline, rank, streaks, languages and organizations.`}
>
  <ProfileApp client:only="react" />
  <noscript>
    <p class="lead">git-card builds profiles in your browser, so it needs JavaScript.</p>
  </noscript>
</Base>
