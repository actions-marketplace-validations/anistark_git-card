---
import Base from '../layouts/Base.astro';
import { urls } from '../lib/urls';
import { SITE } from '../site';

export const prerender = true;
---

<Base
  title="git-card: your GitHub, as a city"
  description="Type a GitHub username and get a 3D contribution skyline, streaks, languages and top repos. Every card has its own link you can embed anywhere."
>
  <section class="hero hud">
    <div class="hero-floor" aria-hidden="true"></div>
    <p class="eyebrow">Public GitHub data // rendered live</p>
    <h1 class="display glitch rgb" data-text="Your GitHub, as a city.">
      Your GitHub, <span class="neon">as a city.</span>
    </h1>
    <p class="lead">
      A 3D skyline of your year, your streaks, languages and best repos. Every card has its own link, so you can drop it into a README, a
      blog or a portfolio.
    </p>
    <form class="lookup" role="search" data-lookup>
      <label for="u" class="eyebrow">
        Target handle
      </label>
      <div class="lookup-row hud">
        <span class="lookup-at" aria-hidden="true">
          &gt; @
        </span>
        <input id="u" name="login" required autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="torvalds" />
        <button type="submit">Jack in</button>
      </div>
    </form>
    <p class="caption try">
      <span>Try</span>
      {/* Commas come from CSS, so formatter line breaks can never put a space before them. */}
      <span class="examples">
        {SITE.examples.map((login) => (
          <a href={urls.profile(login)}>@{login}</a>
        ))}
      </span>
    </p>
  </section>

  <section class="how" id="how">
    <p class="eyebrow">Every card is a URL</p>
    <h2 class="title rgb">Embed one card or the whole thing.</h2>
    <dl class="url-list tabular">
      <div>
        <dt>
          u/<em>login</em>
        </dt>
        <dd>The full profile, built in your browser from public GitHub data.</dd>
      </div>
      <div>
        <dt>
          u/<em>login</em>/c/skyline
        </dt>
        <dd>
          One card on its own page. Add <code>?embed</code> for an iframe.
        </dd>
      </div>
      <div>
        <dt>
          vs/<em>login</em>/<em>rival</em>
        </dt>
        <dd>Two profiles head to head, with a tale of the tape and a verdict.</dd>
      </div>
      <div>
        <dt>README</dt>
        <dd>Every card downloads as an SVG. Add the GitHub Action and it re-renders into your repo every day.</dd>
      </div>
    </dl>
  </section>

  <section class="versus-home" id="versus">
    <p class="eyebrow">Versus // head to head</p>
    <h2 class="title rgb">Settle it.</h2>
    <form class="lookup versus-form" role="search" data-versus>
      <label for="vs-home-a" class="eyebrow">
        Two GitHub usernames
      </label>
      <div class="versus-row">
        <div class="lookup-row hud">
          <span class="lookup-at" aria-hidden="true">
            &gt; @
          </span>
          <input id="vs-home-a" name="a" required autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="torvalds" />
        </div>
        <span class="versus-vs" aria-hidden="true">
          vs
        </span>
        <div class="lookup-row hud">
          <span class="lookup-at" aria-hidden="true">
            &gt; @
          </span>
          <input
            name="b"
            required
            aria-label="Rival's GitHub username"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="gaearon"
          />
        </div>
        <button type="submit">Fight</button>
      </div>
    </form>
  </section>
  <script>
    import { submitLookup, submitVersus } from '../app/lookup';

    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-lookup]')) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        submitLookup(form);
      });
    }
    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-versus]')) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        submitVersus(form);
      });
    }
  </script>
</Base>
