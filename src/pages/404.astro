---
import PathRoute from '../app/PathRoute';
import ErrorState from '../components/ErrorState.astro';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Not found · git-card" description="This page does not exist." noindex>
  <script is:inline define:vars={{ base }}>
    // Before first paint: GitHub Pages serves this page for profile, card and versus paths, so swap the error for
    // the page.
    const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname.replace(/^\//, '');
    if (/^u\/[A-Za-z0-9-]{1,39}\/?$/.test(path)) {
      document.documentElement.dataset.route = 'profile';
      document.title = 'Profile · git-card';
    } else if (/^u\/[A-Za-z0-9-]{1,39}\/c\/[a-z0-9-]+\/?$/.test(path)) {
      document.documentElement.dataset.route = 'card';
      document.title = 'Card · git-card';
    } else if (/^vs\/[A-Za-z0-9-]{1,39}(\/[A-Za-z0-9-]{1,39})?\/?$/.test(path)) {
      document.documentElement.dataset.route = 'versus';
      document.title = 'Versus · git-card';
    }
  </script>
  <div class="not-found">
    <ErrorState status={404} message="There is nothing at this address." />
  </div>
  <PathRoute client:only="react" />
</Base>
