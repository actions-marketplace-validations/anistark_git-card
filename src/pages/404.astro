---
import ProfileRoute from '../app/ProfileRoute';
import ErrorState from '../components/ErrorState.astro';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="Not found · git-card" description="This page does not exist." noindex>
  <script is:inline define:vars={{ base }}>
    // Before first paint: GitHub Pages serves this page for every u/<login>, so swap the error for the profile.
    const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname.replace(/^\//, '');
    if (/^u\/[A-Za-z0-9-]{1,39}\/?$/.test(path)) {
      document.documentElement.dataset.route = 'profile';
      document.title = 'Profile · git-card';
    }
  </script>
  <div class="not-found">
    <ErrorState status={404} message="There is nothing at this address." />
  </div>
  <ProfileRoute client:only="react" />
  <script>
    import { urls } from '../lib/urls';

    // Old server-rendered card links looked like /u/<login>/<card>. Send them to the card page.
    const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
    const path = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname.replace(/^\//, '');
    const match = path.match(/^u\/([A-Za-z0-9-]{1,39})\/([a-z-]+)\/?$/);
    if (match) location.replace(urls.card(match[1], match[2]));
  </script>
</Base>
